# VoiceStudio Configuration
# إعدادات VoiceStudio

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
WORKERS=4

# Audio Settings
SAMPLE_RATE=16000
CHUNK_SIZE=2048
AUDIO_QUALITY=high  # high/medium/low

# Model Settings
WHISPER_MODEL=base  # base/small/medium/large
BARK_SPEAKER=default
TTS_ENGINE=bark  # bark/coqui

# Performance
USE_GPU=true
DEVICE=cuda  # cuda/cpu
BATCH_SIZE=1
CACHE_ENABLED=true

# Language
DEFAULT_LANGUAGE=ar
SUPPORTED_LANGUAGES=ar,en,fr,es

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/voicestudio.log

# Development
DEBUG=false
TESTING=false
CORS_ORIGINS=*

# Optional: Rasa Configuration
RASA_SERVER_URL=http://localhost:5005
USE_RASA=false

# Optional: Database
DATABASE_URL=sqlite:///./voicestudio.db
